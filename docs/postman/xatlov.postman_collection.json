{
  "info": {
    "name": "Xatlov API — 1-bosqich (Davlat muassasalari ro'yxati)",
    "description": "VMQ-247 xatlov tizimining 1-bosqichi: STIR bo'yicha tashkilotlarni qo'shish, yangilash va ommaviy yuklash.\n\nIshlatish:\n1. Environment faylni import qiling (xatlov.local yoki xatlov.server) va login/parolni to'ldiring.\n2. Collection Runner'da yuqoridan pastga ishga tushiring — so'rovlar bir-biriga bog'liq (id o'zgaruvchiga saqlanadi).\n\nTest yozuvlari 999000001 va 999000002 STIR'laridan foydalanadi va oxirida nofaol qilinadi, shuning uchun kolleksiyani xohlagancha qayta ishga tushirish mumkin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{login}}", "type": "string" },
      { "key": "password", "value": "{{parol}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "login", "value": "xatlov" },
    { "key": "parol", "value": "change-me" },
    { "key": "tin_a", "value": "999000001" },
    { "key": "tin_b", "value": "999000002" },
    { "key": "org_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Holat",
      "item": [
        {
          "name": "GET /api/health — ilova va baza holati",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/health", "host": ["{{base_url}}"], "path": ["api", "health"] },
            "description": "Auth talab qilmaydi. Baza yiqilgan bo'lsa 503 va javobda `error` sababi qaytadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 qaytdi', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status = ok', () => pm.expect(b.status).to.eql('ok'));",
                  "pm.test('baza ulangan', () => pm.expect(b.db).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/organisations — parolsiz (401 kutiladi)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/organisations",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations"]
            },
            "description": "Basic auth ishlayotganini tasdiqlaydi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 qaytdi', () => pm.response.to.have.status(401));",
                  "pm.test('WWW-Authenticate sarlavhasi bor', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Tashkilotlar — qo'shish va yangilash",
      "item": [
        {
          "name": "POST /api/organisations — qo'shish (upsert)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"typeid\": 9,\n  \"source_id\": \"POSTMAN-A\",\n  \"org_name\": \"Postman test tashkiloti\",\n  \"region_id\": 26,\n  \"district_id\": 263,\n  \"tin\": \"{{tin_a}}\",\n  \"state\": 1,\n  \"soato\": \"1726269\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/organisations",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations"]
            },
            "description": "STIR yangi bo'lsa 201 (`created`), mavjud bo'lsa 200 (`updated`) qaytadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 yoki 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const b = pm.response.json();",
                  "pm.test('STIR to\\'g\\'ri', () => pm.expect(b.data.tin).to.eql(pm.variables.get('tin_a')));",
                  "pm.collectionVariables.set('org_id', b.data.id);",
                  "console.log('org_id =', b.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/organisations — o'sha STIR yana (yangilanishi kerak)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"typeid\": 9,\n  \"source_id\": \"POSTMAN-A\",\n  \"org_name\": \"Postman test tashkiloti (yangilandi)\",\n  \"region_id\": 26,\n  \"district_id\": 263,\n  \"tin\": \"{{tin_a}}\",\n  \"state\": 1,\n  \"soato\": \"1726269\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/organisations",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations"]
            },
            "description": "Eski API dan asosiy farq: dublikat xatosi emas, yozuv yangilanadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 qaytdi', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('action = updated', () => pm.expect(b.action).to.eql('updated'));",
                  "pm.test('id o\\'zgarmadi (dublikat yaratilmadi)', () => pm.expect(String(b.data.id)).to.eql(String(pm.collectionVariables.get('org_id'))));",
                  "pm.test('nom yangilandi', () => pm.expect(b.data.org_name).to.include('yangilandi'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/organisations?mode=insert — dublikat (409 kutiladi)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
