          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 qaytdi', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('xato maydoni ko\\'rsatilgan', () => pm.expect(b.details[0].field).to.eql('tin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/organisations/:id — qisman yangilash",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"org_name\": \"Postman test tashkiloti (PATCH)\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/organisations/{{org_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations", "{{org_id}}"]
            },
            "description": "Faqat yuborilgan maydon o'zgaradi, qolganlari tegilmaydi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
