          ]
        },
        {
          "name": "POST /api/organisations — noto'g'ri STIR (422 kutiladi)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"org_name\": \"Xato STIR\",\n  \"tin\": \"12345\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/organisations",
              "host": ["{{base_url}}"],
