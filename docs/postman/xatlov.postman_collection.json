                  "const b = pm.response.json();",
                  "pm.test('nom yangilandi', () => pm.expect(b.data.org_name).to.include('PATCH'));",
                  "pm.test('boshqa maydon saqlanib qoldi', () => pm.expect(b.data.soato).to.eql('1726269'));"
                ]
              }
            }
          ]
        },
