    {
      "name": "3. Ommaviy yuklash (bulk)",
      "item": [
        {
          "name": "POST /api/organisations/bulk — 1 yangi + 1 o'zgargan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"davlat-mulki\",\n  \"items\": [\n    {\n      \"typeid\": 9,\n      \"source_id\": \"POSTMAN-A\",\n      \"org_name\": \"Postman test tashkiloti (BULK)\",\n      \"region_id\": 26,\n      \"district_id\": 263,\n      \"tin\": \"{{tin_a}}\",\n      \"soato\": \"1726269\"\n    },\n    {\n      \"typeid\": 9,\n      \"source_id\": \"POSTMAN-B\",\n      \"org_name\": \"Postman test tashkiloti B\",\n      \"region_id\": 26,\n      \"district_id\": 265,\n      \"tin\": \"{{tin_b}}\",\n      \"soato\": \"1726262\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/organisations/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations", "bulk"]
            },
            "description": "\"Davlat mulki\" AT dan kelgan ro'yxatni yuklashning asosiy nuqtasi. Javobda nechtasi yangi, nechtasi yangilangan, nechtasi o'zgarishsiz qolgani ko'rsatiladi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 qaytdi', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().summary;",
                  "pm.test('2 ta yozuv qabul qilindi', () => pm.expect(s.received).to.eql(2));",
                  "pm.test('1 tasi yangilandi', () => pm.expect(s.updated).to.eql(1));",
                  "pm.test('1 tasi o\\'zgarishsiz', () => pm.expect(s.unchanged).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/organisations/bulk — takroran (hammasi unchanged)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"davlat-mulki\",\n  \"items\": [\n    {\n      \"typeid\": 9,\n      \"source_id\": \"POSTMAN-A\",\n      \"org_name\": \"Postman test tashkiloti (BULK)\",\n      \"region_id\": 26,\n      \"district_id\": 263,\n      \"tin\": \"{{tin_a}}\",\n      \"soato\": \"1726269\"\n    },\n    {\n      \"typeid\": 9,\n      \"source_id\": \"POSTMAN-B\",\n      \"org_name\": \"Postman test tashkiloti B\",\n      \"region_id\": 26,\n      \"district_id\": 265,\n      \"tin\": \"{{tin_b}}\",\n      \"soato\": \"1726262\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/organisations/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations", "bulk"]
            },
            "description": "Bir xil ma'lumotni qayta yuborish hech narsani o'zgartirmasligi kerak (idempotent)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 qaytdi', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().summary;",
                  "pm.test('hech narsa o\\'zgarmadi', () => { pm.expect(s.unchanged).to.eql(2); pm.expect(s.created).to.eql(0); pm.expect(s.updated).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/sync-runs — yuklash tarixi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sync-runs?limit=5",
              "host": ["{{base_url}}"],
              "path": ["api", "sync-runs"],
              "query": [{ "key": "limit", "value": "5" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 qaytdi', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('tarix yozilmoqda', () => pm.expect(items.length).to.be.above(0));",
                  "pm.test('sessiya hisobi bor', () => pm.expect(items[0]).to.have.property('unchanged_count'));"
                ]
              }
            }
          ]
        }
      ]
    },
