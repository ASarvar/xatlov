# Serverda `.env` nomi bilan saqlanadi:  cp .env.production.example .env
# Diqqat: bu fayl git ga tushmaydi (.gitignore). Parollarni albatta o'zgartiring!

# ---- Ilova ----
NODE_ENV=production
TZ=Asia/Tashkent

# Serverdagi port
APP_PORT=9091
# 127.0.0.1 — faqat nginx orqali kiriladi (tavsiya etiladi)
# 0.0.0.0    — port to'g'ridan-to'g'ri tashqariga ochiladi
BIND_HOST=127.0.0.1

# ---- PostgreSQL (konteyner ichida, tashqariga chiqarilmaydi) ----
POSTGRES_USER=xatlov
# openssl rand -base64 24  bilan yarating
POSTGRES_PASSWORD=ALMASHTIRING_kuchli_parol
POSTGRES_DB=xatlov

# ---- API himoyasi (Basic auth) ----
BASIC_USER=xatlov
# openssl rand -base64 24  bilan yarating
BASIC_PASS=ALMASHTIRING_kuchli_parol
