            "url": {
              "raw": "{{base_url}}/api/organisations?mode=insert",
              "host": ["{{base_url}}"],
              "path": ["api", "organisations"],
              "query": [{ "key": "mode", "value": "insert" }]
            },
            "description": "Qat'iy qo'shish rejimi: mavjud STIR uchun 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 qaytdi', () => pm.response.to.have.status(409));"]
